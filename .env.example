# ==============================================================================
# ENVIRONMENT VARIABLES: Maddala Varshini Portfolio
# Primary Database: MongoDB Atlas
# Copy this file to .env.local and replace placeholders with your credentials.
# NEVER commit .env.local or production database credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY DATABASE: MONGODB ATLAS (REQUIRED FOR CLOUD PERSISTENCE)
# ------------------------------------------------------------------------------
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# How to obtain:
#   1. Sign in to MongoDB Atlas (cloud.mongodb.com).
#   2. Go to Database > Connect > Drivers > Node.js.
#   3. Copy the connection string and replace <username> and <password> with your Atlas database user.
#   4. Ensure Network Access: In Network Access tab, add your deployment IP or 0.0.0.0/0 for serverless (Vercel).
MONGODB_URI=mongodb+srv://maddala_admin:YOUR_PASSWORD_HERE@cluster0.mongodb.net/?retryWrites=true&w=majority

# Target MongoDB Database Name
MONGODB_DB=maddala_portfolio

# ------------------------------------------------------------------------------
# 2. APPLICATION SECURITY & ACCESS CONTROL (SERVER ONLY)
# ------------------------------------------------------------------------------
# Authorized Portfolio Owner Email. Server-side middleware validates authenticated users against this email.
ADMIN_EMAIL=maddalavarshini@example.com

# Server-only secret key for signing admin API mutations and internal sessions
ADMIN_SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string

# ------------------------------------------------------------------------------
# 3. SITE URL & ENVIRONMENT
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. OPTIONAL: SUPABASE AUTH & STORAGE (RETAINED AS STORAGE / AUTH PROVIDER)
# ------------------------------------------------------------------------------
# If utilizing Supabase Auth or Supabase Storage buckets for PDF / image binaries:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder
